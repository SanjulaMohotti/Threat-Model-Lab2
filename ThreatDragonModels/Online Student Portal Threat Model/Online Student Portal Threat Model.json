  "summary": {
    "title": "Online Student Portal Threat Model",
    "owner": "Sanjula Kalpani",
    "description": "This threat model describes an online student portal that allows students to log in and view examination results, lecturers to upload and modify marks, and administrators to manage user accounts. Student information and examination results are stored in a central database. The system is accessible through the Internet and uses an authentication service to verify users.",
    "id": 0
  },
